      <langSet xml:lang="zh-TW"><tig><term>發光</term></tig></langSet>
    </termEntry>
    <termEntry id="e1573">
      <langSet xml:lang="ja"><tig><term>描画時に不透明度を変化させない</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绘制时不改变不透明度</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>繪製時不改變不透明度</term></tig></langSet>
    </termEntry>
    <termEntry id="e1574">
      <langSet xml:lang="ja"><tig><term>下のレイヤーの不透明度部分にのみ合成</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仅在下层图层的不透明区域合成</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>僅在下層圖層的不透明區域合成</term></tig></langSet>
    </termEntry>
    <termEntry id="e1575">
