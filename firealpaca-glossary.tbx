      <langSet xml:lang="zh-CN"><tig><term>当前图层</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>作用中圖層</term></tig></langSet>
    </termEntry>
    <termEntry id="e1813">
      <langSet xml:lang="ja"><tig><term>指定レイヤー</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>指定图层</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>指定圖層</term></tig></langSet>
    </termEntry>
    <termEntry id="e1814">
      <langSet xml:lang="ja"><tig><term>ドラッグ時にもスポイト</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拖拽时也可吸取颜色</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>拖曳時也可吸取顏色</term></tig></langSet>
    </termEntry>
    <termEntry id="e1815">
      <langSet xml:lang="ja"><tig><term>本当にレイヤーを削除しますか？</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>确定要删除图层吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>確定要刪除圖層嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e1816">
      <langSet xml:lang="ja"><tig><term>環境設定から確認なしに削除するよう設定できます</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可以在环境设置中设置删除时不确认</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>可在環境設定中設定刪除時不確認</term></tig></langSet>
    </termEntry>
    <termEntry id="e1817">
      <langSet xml:lang="ja"><tig><term>メモリ消費量が半分になりますが、色精度が低下します。宜しいですか？</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内存消耗减半，但颜色精度会降低。确定吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>記憶體消耗減半，但顏色精度會降低。確定嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e1818">
      <langSet xml:lang="ja"><tig><term>色精度が向上し編集時の劣化が軽減しますが、メモリ使用量が倍になります。宜しいですか？</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>颜色精度提高，编辑时的画质损失减少，但内存使用量会加倍。确定吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>顏色精度提高，編輯時的畫質損失減少，但記憶體使用量會加倍。確定嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e1819">
      <langSet xml:lang="ja"><tig><term>既存のレイヤーを 8bit/ch に変換しますか？</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>기존 레이어를 8bit/ch로 변환하시겠습니까?</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>要将现有图层转换为 8bit/ch 吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>要將現有圖層轉換為 8bit/ch 嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e1820">
      <langSet xml:lang="ja"><tig><term>既存のレイヤーを 16bit/ch に変換しますか？</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>기존 레이어를 16bit/ch로 변환하시겠습니까?</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>要将现有图层转换为 16bit/ch 吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>要將現有圖層轉換為 16bit/ch 嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e1821">
      <langSet xml:lang="ja"><tig><term>上級者向けの設定ですが、本当に有効にしますか？</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>这是面向高级用户的设置，确定要启用吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>這是進階使用者的設定，確定要啟用嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e1822">
      <langSet xml:lang="ja"><tig><term>MFG アーカイブ形式(*.mar)</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>MFG 아카이브 형식 (*.mar)</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>MFG 存档格式（*.mar）</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>MFG 封存格式（*.mar）</term></tig></langSet>
