    <termEntry id="e1803">
      <langSet xml:lang="ja"><tig><term>旧バージョンの設定を引き継ぎますか？</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>要沿用旧版本的设置吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>要沿用舊版本的設定嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e1804">
      <langSet xml:lang="ja"><tig><term>設定ファイルをバックアップしました。バックアップしたフォルダを開きますか？</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>已备份配置文件。要打开备份文件夹吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>已備份設定檔。要開啟備份資料夾嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e1805">
      <langSet xml:lang="ja"><tig><term>ブラシ、カラー、グラデーション、ショートカット設定をバックアップしますか？</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>要备份笔刷、颜色、渐变和快捷键设置吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>要備份筆刷、顏色、漸層與快捷鍵設定嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e1806">
      <langSet xml:lang="ja"><tig><term>現在の設定は破棄されますが、宜しいですか？</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>当前设置将被丢弃，确定吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>目前設定將被捨棄，確定嗎？</term></tig></langSet>
    </termEntry>
