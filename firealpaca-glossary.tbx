<?xml version="1.0" encoding="UTF-8"?>
<martif type="TBX-Basic" xml:lang="ja">
  <martifHeader><fileDesc><titleStmt><title>FireAlpaca UI terminology (full extraction)</title></titleStmt>
  <sourceDesc><p>FireAlpaca 2.16.3 binary language blocks, aligned worktable; cn_finalize_l10n.py</p></sourceDesc>
  </fileDesc></martifHeader>
  <text><body>
    <termEntry id="e0">
      <langSet xml:lang="ja"><tig><term>レイヤー</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>图层</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>圖層</term></tig></langSet>
    </termEntry>
    <termEntry id="e1">
      <langSet xml:lang="ja"><tig><term>貼り付け</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>粘贴</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>貼上</term></tig></langSet>
    </termEntry>
    <termEntry id="e2">
      <langSet xml:lang="ja"><tig><term>フォルダー</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>文件夹</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>資料夾</term></tig></langSet>
    </termEntry>
    <termEntry id="e3">
      <langSet xml:lang="ja"><tig><term>フレーム</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>帧</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>影格</term></tig></langSet>
    </termEntry>
    <termEntry id="e4">
      <langSet xml:lang="ja"><tig><term>マスク</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蒙版</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>遮罩</term></tig></langSet>
    </termEntry>
    <termEntry id="e5">
      <langSet xml:lang="ja"><tig><term>ステンシル</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>模板</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>模板</term></tig></langSet>
    </termEntry>
    <termEntry id="e6">
      <langSet xml:lang="ja"><tig><term>Shiftキーを押しながらで直線描画、Ctrl+Altキーを押しながら左右ドラッグでブラシサイズ変更、A+クリックでレイヤーのアクティブ化</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>Shift 키를 누르면서 직선 그리기, Ctrl+Alt키를 누르면서 좌우 드래그로 브러시 사이즈 변경, A+ 클릭으로 레이어 활성화</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>按住Shift键绘制直线，按住Ctrl+Alt键左右拖拽更改笔刷大小，按A+单击激活图层</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>按住Shift鍵繪製直線，按住Ctrl+Alt鍵左右拖曳更改筆刷大小，按A+點擊啟用圖層</term></tig></langSet>
    </termEntry>
    <termEntry id="e7">
      <langSet xml:lang="ja"><tig><term>描画レイヤーが非表示です</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绘图图层已隐藏</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>繪圖圖層已隱藏</term></tig></langSet>
    </termEntry>
    <termEntry id="e8">
      <langSet xml:lang="ja"><tig><term>描画レイヤーがロックされています</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绘图图层已锁定</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>繪圖圖層已鎖定</term></tig></langSet>
    </termEntry>
    <termEntry id="e9">
      <langSet xml:lang="ja"><tig><term>描画レイヤーが処理中です</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绘图图层正在处理中</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>繪圖圖層處理中</term></tig></langSet>
    </termEntry>
    <termEntry id="e10">
      <langSet xml:lang="ja"><tig><term>描画先レイヤーに非対応のブラシタイプです</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绘图目标图层不支持此笔刷类型</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>繪圖目標圖層不支援此筆刷類型</term></tig></langSet>
    </termEntry>
    <termEntry id="e11">
      <langSet xml:lang="ja"><tig><term>[ふちペン] Ctrlキーを押しながらでエッジを保持して描画</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>[테두리 펜] Ctrl키를 꾹 누르면 테두리 유지</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>[中空笔刷] 按住Ctrl键保持边缘描画</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>[中空筆] 按住Ctrl鍵維持邊緣繪圖</term></tig></langSet>
    </termEntry>
    <termEntry id="e12">
      <langSet xml:lang="ja"><tig><term>[ふちペン] 不透明ブラシの場合、エッジを保持して描画できます</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>[中空笔刷] 使用不透明笔刷时可保持边缘绘制</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>[中空筆] 使用不透明筆刷時可維持邊緣繪圖</term></tig></langSet>
    </termEntry>
    <termEntry id="e13">
      <langSet xml:lang="ja"><tig><term>Shiftキーを押しながらで追加、Ctrlキーを押しながらで削除</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>Shift 키를 꾹 눌러서 추가, Ctrl키를 꾹 눌러서 삭제</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>按住Shift键添加，按住Ctrl键删除</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>按住Shift鍵加入，按住Ctrl鍵刪除</term></tig></langSet>
    </termEntry>
    <termEntry id="e14">
      <langSet xml:lang="ja"><tig><term>Shiftキーを押しながらで追加、Altキーを押しながらで削除</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>Shift 키를 꾹 눌러서 추가, Alt키를 꾹 눌러서 삭제</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>按住Shift键添加，按住Alt键删除</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>按住Shift鍵加入，按住Alt鍵刪除</term></tig></langSet>
    </termEntry>
    <termEntry id="e15">
      <langSet xml:lang="ja"><tig><term>レイヤーがロックされているので編集できません</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>图层已锁定，无法编辑</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>圖層已鎖定，無法編輯</term></tig></langSet>
    </termEntry>
    <termEntry id="e16">
      <langSet xml:lang="ja"><tig><term>Ctrlキーを押しながらで15度単位の回転</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>Ctrl 키를 꾹 눌러서 15도 단위로 회전</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>按住Ctrl键以15度为增量旋转</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>按住Ctrl鍵以15度為單位旋轉</term></tig></langSet>
    </termEntry>
    <termEntry id="e17">
      <langSet xml:lang="ja"><tig><term>Shiftキーを押しながらで水平・垂直に操作</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>Shift 키를 꾹 눌러서 수평·수직으로 조작</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>按住Shift键进行水平·垂直操作</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>按住Shift鍵進行水平·垂直操作</term></tig></langSet>
    </termEntry>
    <termEntry id="e18">
      <langSet xml:lang="ja"><tig><term>クリックでズームイン. </term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单击放大</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>點擊放大</term></tig></langSet>
    </termEntry>
    <termEntry id="e19">
      <langSet xml:lang="ja"><tig><term>クリックでズームアウト. </term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单击缩小</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>點擊縮小</term></tig></langSet>
    </termEntry>
    <termEntry id="e20">
      <langSet xml:lang="ja"><tig><term>上下ドラッグでズーム.</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>上下拖拽缩放</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>上下拖曳縮放</term></tig></langSet>
    </termEntry>
    <termEntry id="e21">
      <langSet xml:lang="ja"><tig><term>左右ドラッグでズーム.</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>左右拖拽缩放</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>左右拖曳縮放</term></tig></langSet>
    </termEntry>
    <termEntry id="e22">
      <langSet xml:lang="ja"><tig><term>4点クリックで消失点を指定</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>4개의 점을 클릭하여 소실점 지정</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单击4个点指定消失点</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>點擊4個點指定消失點</term></tig></langSet>
    </termEntry>
    <termEntry id="e23">
      <langSet xml:lang="ja"><tig><term>Ctrl＋ドラッグでスナップ頂点の移動</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>Ctrl＋드래그하여 스냅 꼭짓점 이동</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>Ctrl+拖拽移动吸附顶点</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>Ctrl+拖曳移動貼齊頂點</term></tig></langSet>
    </termEntry>
    <termEntry id="e24">
      <langSet xml:lang="ja"><tig><term>Ctrl＋ドラッグで楕円スナップ作成</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>Ctrl＋드래그하여 타원 스냅 작성</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>Ctrl+拖拽创建椭圆吸附</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>Ctrl+拖曳建立橢圓貼齊</term></tig></langSet>
    </termEntry>
    <termEntry id="e25">
      <langSet xml:lang="ja"><tig><term>ドラッグで分割、+Shiftで自由な角度</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>드래그하여 분할, +Shift로 자유롭게 각도 조절</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拖拽分割，+Shift设置任意角度</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>拖曳分割，+Shift設定任意角度</term></tig></langSet>
    </termEntry>
    <termEntry id="e26">
      <langSet xml:lang="ja"><tig><term>Ctrl+クリックで基点指定 (キャンバス)</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>Ctrl+클릭하여 기준점 지정 (캔버스)</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>Ctrl+单击指定基点（画布）</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>Ctrl+點擊指定基準點（畫布）</term></tig></langSet>
    </termEntry>
    <termEntry id="e27">
      <langSet xml:lang="ja"><tig><term>Ctrlキーを押しながら辺をドラッグすると長さを維持して平行移動</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>Ctrl키를 누른 상태로 드래그하여 길이를 유지한 채로 평행이동</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>按住Ctrl键拖拽边缘可保持长度平行移动</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>按住Ctrl鍵拖曳邊緣可保持長度平行移動</term></tig></langSet>
    </termEntry>
    <termEntry id="e28">
      <langSet xml:lang="ja"><tig><term>+Shiftキーでキャンバス色取得</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>+Shift키를 눌러서 캔버스 색 추출</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>+Shift键获取画布颜色</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>+Shift鍵取得畫布顏色</term></tig></langSet>
    </termEntry>
    <termEntry id="e29">
      <langSet xml:lang="ja"><tig><term>+Shiftキーでアクティブレイヤー色取得</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>+Shift키를 눌러서 활성 레이어 색 추출</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>+Shift键获取当前图层颜色</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>+Shift鍵取得作用中圖層顏色</term></tig></langSet>
    </termEntry>
    <termEntry id="e30">
      <langSet xml:lang="ja"><tig><term>クリックで一番上のレイヤーを選択、ドラッグで範囲内のレイヤーを選択</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单击选择最上层图层，拖拽选择范围内的图层</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>點擊選擇最上層圖層，拖曳選擇範圍內的圖層</term></tig></langSet>
    </termEntry>
    <termEntry id="e31">
      <langSet xml:lang="ja"><tig><term>文件夹</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>文件夹</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>資料夾</term></tig></langSet>
    </termEntry>
    <termEntry id="e32">
      <langSet xml:lang="ja"><tig><term>模板</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>模板</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>模板</term></tig></langSet>
    </termEntry>
    <termEntry id="e33">
      <langSet xml:lang="ja"><tig><term>按 Shift 键来水平．垂直地操作</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>按住Shift键进行水平·垂直操作</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>按住Shift鍵進行水平·垂直操作</term></tig></langSet>
    </termEntry>
    <termEntry id="e34">
      <langSet xml:lang="ja"><tig><term>Ctrl＋拖拽作成椭圆规尺</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>Ctrl+拖拽创建椭圆规尺</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>Ctrl+拖曳建立橢圓尺規</term></tig></langSet>
    </termEntry>
    <termEntry id="e35">
      <langSet xml:lang="ja"><tig><term>拖拽来分割；用+Shift来设置任意的角度</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拖拽分割，+Shift设置任意角度</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>拖曳分割，+Shift設定任意角度</term></tig></langSet>
    </termEntry>
    <termEntry id="e36">
      <langSet xml:lang="ja"><tig><term>+Shift键取得画布的颜色</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>+Shift键获取画布颜色</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>+Shift鍵取得畫布顏色</term></tig></langSet>
    </termEntry>
    <termEntry id="e37">
      <langSet xml:lang="ja"><tig><term>+Shift键取得显示图层的颜色</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>+Shift键获取显示图层的颜色</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>+Shift鍵取得顯示圖層的顏色</term></tig></langSet>
    </termEntry>
    <termEntry id="e38">
      <langSet xml:lang="ja"><tig><term>按 Shift 鍵進行水準．垂直操作</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>按住Shift键进行水平·垂直操作</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>按住Shift鍵進行水平·垂直操作</term></tig></langSet>
    </termEntry>
    <termEntry id="e39">
      <langSet xml:lang="ja"><tig><term>Ctrl+拖曳移動輔助頂點</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>Ctrl+拖拽移动吸附顶点</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>Ctrl+拖曳移動貼齊頂點</term></tig></langSet>
    </termEntry>
    <termEntry id="e40">
      <langSet xml:lang="ja"><tig><term>Ctrl+拖曳製作橢圓輔助</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>Ctrl+拖拽创建椭圆吸附</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>Ctrl+拖曳建立橢圓貼齊</term></tig></langSet>
    </termEntry>
    <termEntry id="e41">
      <langSet xml:lang="ja"><tig><term>+Shift鍵取得畫布的顏色</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>+Shift键获取画布颜色</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>+Shift鍵取得畫布顏色</term></tig></langSet>
    </termEntry>
    <termEntry id="e42">
      <langSet xml:lang="ja"><tig><term>+Shift鍵取得顯示圖層的顏色</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>+Shift键获取显示图层的颜色</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>+Shift鍵取得顯示圖層的顏色</term></tig></langSet>
    </termEntry>
    <termEntry id="e43">
      <langSet xml:lang="ja"><tig><term>3Dパースを編集</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>3D 퍼스 편집</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>编辑3D透视</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>編輯3D透視</term></tig></langSet>
    </termEntry>
    <termEntry id="e44">
      <langSet xml:lang="ja"><tig><term>長辺の分割数</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>长边分割数</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>長邊分割數</term></tig></langSet>
    </termEntry>
    <termEntry id="e45">
      <langSet xml:lang="ja"><tig><term>短辺の分割数</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>短边分割数</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>短邊分割數</term></tig></langSet>
    </termEntry>
    <termEntry id="e46">
      <langSet xml:lang="ja"><tig><term>標準カメラ</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准相机</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>標準相機</term></tig></langSet>
    </termEntry>
    <termEntry id="e47">
      <langSet xml:lang="ja"><tig><term>更新</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>更新</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>更新</term></tig></langSet>
    </termEntry>
    <termEntry id="e48">
      <langSet xml:lang="ja"><tig><term>編集を適用しないで閉じますか？</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不应用编辑直接关闭吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>不套用編輯直接關閉嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e49">
      <langSet xml:lang="ja"><tig><term>カメラモード</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相机模式</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>相機模式</term></tig></langSet>
    </termEntry>
    <termEntry id="e50">
      <langSet xml:lang="ja"><tig><term>選択ツール</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>选择工具</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>選取工具</term></tig></langSet>
    </termEntry>
    <termEntry id="e51">
      <langSet xml:lang="ja"><tig><term>移動ツール</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>移动工具</term></tig></langSet>
