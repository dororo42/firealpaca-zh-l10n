      <langSet xml:lang="zh-CN"><tig><term>砖块（彩色）</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>磚塊（彩色）</term></tig></langSet>
    </termEntry>
    <termEntry id="e739">
      <langSet xml:lang="ja"><tig><term>BIG KATSU (炸豬排金棕表皮)</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>BIG KATSU (炸猪排金棕表皮)</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>BIG KATSU (炸豬排金棕表皮)</term></tig></langSet>
    </termEntry>
    <termEntry id="e740">
      <langSet xml:lang="ja"><tig><term>閉じる前に保存しますか？</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>关闭前要保存吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>關閉前要儲存嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e741">
      <langSet xml:lang="ja"><tig><term>画像の保存</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>保存图像</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>儲存影像</term></tig></langSet>
    </termEntry>
    <termEntry id="e742">
      <langSet xml:lang="ja"><tig><term>この形式ではレイヤーが保存されませんが、よろしいですか？</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>此格式不会保存图层，确定吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>此格式不會儲存圖層，確定嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e743">
      <langSet xml:lang="ja"><tig><term>この形式ではレイヤーが結合されて保存され、下書きレイヤーの内容は表示されなくなります。よろしいですか？</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>此格式将合并图层后保存，草稿图层的内容将不再显示。确定吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>此格式將合併圖層後儲存，草稿圖層的內容將不再顯示。確定嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e744">
      <langSet xml:lang="ja"><tig><term>変形を適用しますか？</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>要应用变换吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>要套用變形嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e745">
      <langSet xml:lang="ja"><tig><term>画像の書き出し (CMYK形式 PSD)</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>이미지 내보내기 (CMYK 포맷 PSD)</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>导出图像（CMYK格式PSD）</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>匯出影像（CMYK格式PSD）</term></tig></langSet>
    </termEntry>
    <termEntry id="e746">
      <langSet xml:lang="ja"><tig><term>「表示」メニューからCMYKソフトプルーフを有効にし、CMYKプレビューを行ってください</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>"보기" 메뉴에서 CMYK 소프트 프루프를 활성화하고, CMYK 미리보기를 실행하십시오.</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>请从「显示」菜单启用CMYK软打样并进行CMYK预览</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>請從「顯示」選單啟用CMYK軟式打樣並進行CMYK預覽</term></tig></langSet>
    </termEntry>
    <termEntry id="e747">
      <langSet xml:lang="ja"><tig><term>キャンバス範囲外を削除しますか？</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>要删除画布范围外的内容吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>要刪除畫布範圍外的內容嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e748">
      <langSet xml:lang="ja"><tig><term>レイヤーデータが欠落しています</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>图层数据缺失</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>圖層資料遺失</term></tig></langSet>
    </termEntry>
    <termEntry id="e749">
      <langSet xml:lang="ja"><tig><term>画像を新規レイヤーとして読み込む</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>将图像读取为新图层</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>將影像載入為新圖層</term></tig></langSet>
    </termEntry>
    <termEntry id="e750">
      <langSet xml:lang="ja"><tig><term>非表示レイヤーにも適用しますか？</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>也要应用到隐藏图层吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>也要套用到隱藏圖層嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e751">
      <langSet xml:lang="ja"><tig><term>画像の書き出し (APNG)</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>이미지 내보내기 (APNG)</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>导出图像（APNG）</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>匯出影像（APNG）</term></tig></langSet>
    </termEntry>
    <termEntry id="e752">
      <langSet xml:lang="ja"><tig><term>画像の書き出し (アニメーションGIF)</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>이미지 내보내기 (애니메이션 GIF)</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>导出图像（动画GIF）</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>匯出影像（動畫GIF）</term></tig></langSet>
    </termEntry>
    <termEntry id="e753">
      <langSet xml:lang="ja"><tig><term>幅と高さを 256px 以内にする必要があります</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>너비와 높이가 256px 이내여야 합니다.</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>宽高需在256px以内</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>寬高需在256px以內</term></tig></langSet>
    </termEntry>
    <termEntry id="e754">
      <langSet xml:lang="ja"><tig><term>画像の書き出し (ICO)</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>이미지 내보내기 (ICO)</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>导出图像（ICO）</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>匯出影像（ICO）</term></tig></langSet>
    </termEntry>
    <termEntry id="e755">
      <langSet xml:lang="ja"><tig><term>上書きしますか？</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>要覆盖吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>要覆寫嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e756">
      <langSet xml:lang="ja"><tig><term>"%1"という名前のファイルは既に同じパスに存在しています。上書きしますか？</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>이름이 "%1"인 파일이 이미 존재합니다. 덮어쓰시겠습니까?</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>名为"%1"的文件已存在于同一路径。要覆盖吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>名為"%1"的檔案已存在於同一路徑。要覆寫嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e757">
      <langSet xml:lang="ja"><tig><term>タイムラプスファイルの保存</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>保存延时摄影文件</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>儲存縮時攝影檔案</term></tig></langSet>
    </termEntry>
    <termEntry id="e758">
      <langSet xml:lang="ja"><tig><term>変換元ファイル</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>源文件</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>來源檔案</term></tig></langSet>
    </termEntry>
    <termEntry id="e759">
      <langSet xml:lang="ja"><tig><term>メインメモリが逼迫した状態です。緊急処理でメモリの解放を行いました。再度保存を行ってください。</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>主内存紧张，已通过紧急处理释放内存。请再次保存。</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>主記憶體緊張，已透過緊急處理釋放記憶體。請再次儲存。</term></tig></langSet>
    </termEntry>
    <termEntry id="e760">
      <langSet xml:lang="ja"><tig><term>動画の書き出し (MP4)</term></tig></langSet>
      <langSet xml:lang="ko"><tig><term>동영상 내보내기 (MP4)</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>导出视频（MP4）</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>匯出影片（MP4）</term></tig></langSet>
    </termEntry>
    <termEntry id="e761">
      <langSet xml:lang="ja"><tig><term>動画ファイルに変換</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转换为视频文件</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>轉換為影片檔案</term></tig></langSet>
    </termEntry>
    <termEntry id="e762">
      <langSet xml:lang="ja"><tig><term>全てのテキストレイヤーの画像を、ラスタライズして更新しますか？</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>要将所有文本图层的图像栅格化并更新吗？</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>要將所有文字圖層的影像點陣化並更新嗎？</term></tig></langSet>
    </termEntry>
    <termEntry id="e763">
      <langSet xml:lang="ja"><tig><term>不正なPSDファイルです</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无效的PSD文件</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>無效的PSD檔案</term></tig></langSet>
    </termEntry>
    <termEntry id="e764">
      <langSet xml:lang="ja"><tig><term>非対応の色深度です</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不支持的色深</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>不支援的色彩深度</term></tig></langSet>
    </termEntry>
    <termEntry id="e765">
      <langSet xml:lang="ja"><tig><term>非対応のカラーモードです</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不支持的色彩模式</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>不支援的色彩模式</term></tig></langSet>
    </termEntry>
    <termEntry id="e766">
      <langSet xml:lang="ja"><tig><term>保存所需空间不足</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>保存所需空间不足</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>儲存所需空間不足</term></tig></langSet>
    </termEntry>
    <termEntry id="e767">
      <langSet xml:lang="ja"><tig><term>转换为视频文件</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转换为视频文件</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>轉換為影片檔案</term></tig></langSet>
    </termEntry>
    <termEntry id="e768">
      <langSet xml:lang="ja"><tig><term>匯出影片 (MP4)</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>导出视频（MP4）</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>匯出影片（MP4）</term></tig></langSet>
    </termEntry>
    <termEntry id="e769">
      <langSet xml:lang="ja"><tig><term>マウスホイールの方向</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>鼠标滚轮方向</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>滑鼠滾輪方向</term></tig></langSet>
    </termEntry>
    <termEntry id="e770">
      <langSet xml:lang="ja"><tig><term>反転 (上方向で拡大表示、下方向で縮小表示)</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反转（向上放大显示，向下缩小显示）</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>反轉（向上放大顯示，向下縮小顯示）</term></tig></langSet>
    </termEntry>
    <termEntry id="e771">
      <langSet xml:lang="ja"><tig><term>回転角度</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>旋转角度</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>旋轉角度</term></tig></langSet>
    </termEntry>
    <termEntry id="e772">
      <langSet xml:lang="ja"><tig><term>ドラッグズーム</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拖拽缩放</term></tig></langSet>
      <langSet xml:lang="zh-TW"><tig><term>拖曳縮放</term></tig></langSet>
